{
  "name": "rdtsc",
  "version": "6.0.0",
  "description": "The most high resolution cross platform timing in NodeJs that use processor command RDTSC. Calculate performance with accuracy down to +/- 4 processor cycles.",
  "main": "dist/common/index.cjs",
  "module": "dist/common/index.mjs",
  "types": "dist/common/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "browser": {
        "types": "./dist/browser/index.d.ts",
        "import": "./dist/browser/index.mjs",
        "require": "./dist/browser/index.cjs"
      },
      "node": {
        "types": "./dist/node/index.d.ts",
        "import": "./dist/node/index.mjs",
        "require": "./dist/node/index.cjs"
      },
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.mjs",
      "require": "./dist/common/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.mjs",
      "require": "./dist/browser/index.cjs"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "browser": [
        "./dist/browser/index.d.ts"
      ],
      "node": [
        "./dist/node/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikolayMakhonin/nodejs-rdtsc.git"
  },
  "keywords": [
    "native",
    "high-resolution",
    "performance",
    "timing",
    "rdtsc",
    "benchmark",
    "processor-cycles",
    "tick",
    "stopwatch",
    "duration",
    "thread-priority",
    "process-priority",
    "cross-platform"
  ],
  "author": {
    "name": "Nikolay Makhonin",
    "url": "https://github.com/NikolayMakhonin/"
  },
  "license": "Unlimited Free",
  "bugs": {
    "url": "https://github.com/NikolayMakhonin/nodejs-rdtsc/issues"
  },
  "homepage": "https://github.com/NikolayMakhonin/nodejs-rdtsc",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "install": "npm run build:gyp",
    "prepublishOnly": "pnpm run audit && pnpm run build && pnpm run lint && pnpm run check:types && pnpm run test:all",
    "audit": "pnpm audit --prod",
    "lint": "eslint \"./**/*.{js,cjs,mjs,ts,tsx}\"",
    "lint:fix": "eslint --fix \"./**/*.{js,cjs,mjs,ts,tsx}\"",
    "lint:wizard": "eslint-nibble --cache --multi \"./**/*.{js,cjs,mjs,ts,tsx}\"",
    "check:types": "tsc --noEmit",
    "build:js": "vite build",
    "build:gyp": "node-gyp rebuild",
    "build": "pnpm run build:gyp && pnpm run build:js",
    "coverage": "vitest --run --config vite.projects.ts --coverage",
    "test": "vitest --run --config vite.projects.ts --project node --bail 3",
    "test:stress": "vitest --run --config vite.projects.ts --project stress --bail 3",
    "test:all": "vitest --run --config vite.projects.ts --bail 3"
  },
  "devDependencies": {
    "@flemist/test-variants": "5.0.18",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "8.18.0",
    "eslint-config-pro": "3.0.15",
    "eslint-nibble": "9.1.1",
    "node-gyp": "13.0.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.0.14",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.7"
  }
}
