{
  "ts-node": {
    "compilerOptions": {
      "module": "nodenext",
      "moduleResolution": "nodenext"
    },
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules/**/*",
    "dist/**/*"
  ],
  "compilerOptions": {
    "target": "es6",
    "module": "es6",
    "isolatedModules": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "newLine": "LF",
    "types": [
      "node",
      "mocha"
    ],
    "lib": [
      "DOM",
      "ESNext"
    ]
  }
}
